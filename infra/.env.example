# Compose-level environment for the RRE stack.
# Copy to infra/.env (never commit the real .env):
#   cp infra/.env.example infra/.env
#
# `make up` / scripts/up.sh load this via `--env-file infra/.env`.

# --- Postgres (REQUIRED — compose fails fast if POSTGRES_PASSWORD is unset) ---
POSTGRES_USER=rre
POSTGRES_PASSWORD=rre
POSTGRES_DB=rre

# --- Backend ------------------------------------------------------------------
APP_ENV=dev
APP_VERSION=0.1.0
GIT_COMMIT=local
FRONTEND_ORIGIN=http://localhost:3000
DB_MAX_CONNECTIONS=10

# --- Frontend (build-time, inlined into the client bundle) --------------------
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Proxy --------------------------------------------------------------------
ACTIVE_VERSION_TTL_SECS=30
COMPILED_CACHE_CAPACITY=256
UPSTREAM_CONNECT_TIMEOUT_SECS=2
UPSTREAM_READ_TIMEOUT_SECS=10
