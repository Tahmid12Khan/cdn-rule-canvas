# RRE Proxy configuration.
#
# Config is layered (highest wins): proxy/config/default.json is overlaid by
# proxy/config/{APP_ENV}.json, then by the environment variables below. The
# committed base values live in the JSON files; env vars are the top override
# layer for secrets and per-deploy tweaks. Nested keys use `__` as separator.

# Profile selector: picks proxy/config/{APP_ENV}.json (default "dev").
# "dev" enables pretty tracing output; anything else uses JSON logs.
APP_ENV=dev

# Bind address for the proxy server.
PROXY_BIND_ADDR=0.0.0.0:9000

# Upstream origin the proxy forwards requests to.
UPSTREAM_BASE_URL=http://demo-upstream:8081

# RRE backend (active-version source of truth).
BACKEND_BASE_URL=http://backend:8000

# TTL for the active-version moka cache (seconds).
ACTIVE_VERSION_TTL_SECS=30

# Max compiled DecisionContent entries held in the moka LRU cache.
COMPILED_CACHE_CAPACITY=256

# Upstream connect/read timeouts (seconds).
UPSTREAM_CONNECT_TIMEOUT_SECS=2
UPSTREAM_READ_TIMEOUT_SECS=10

# Config file paths (sanitizer allow-list stays YAML).
SANITIZER_CONFIG_PATH=proxy/config/sanitizer.yaml
