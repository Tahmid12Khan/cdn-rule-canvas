# RRE Backend environment template. Copy to `.env` (never commit `.env`).
#
# Non-secret defaults live in the layered JSON config files
# (`config/default.json` + `config/{APP_ENV}.json`). The environment is the
# top override layer: secrets (DATABASE_URL) and per-deploy overrides only.

# Postgres connection string (sqlx) — env-only secret. Schema `rre` is created
# by migrations.
DATABASE_URL=postgres://rre:rre@localhost:5432/rre

# Selects the JSON profile layer (config/{APP_ENV}.json): dev | staging | prod.
APP_ENV=dev

# --- Optional per-deploy overrides (otherwise sourced from the JSON layers) ---
# APP_VERSION=0.1.0
# GIT_COMMIT=local
# FRONTEND_ORIGIN=http://localhost:3000
# BIND_ADDR=0.0.0.0:8000
# DB_MAX_CONNECTIONS=10
