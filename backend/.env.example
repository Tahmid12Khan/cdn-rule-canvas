# RRE Backend environment template. Copy to `.env` (never commit `.env`).

# Postgres connection string (sqlx). Schema `rre` is created by migrations.
DATABASE_URL=postgres://rre:rre@localhost:5432/rre

# Deployment environment label: dev | staging | prod (controls log format).
APP_ENV=dev

# Reported by /health.
APP_VERSION=0.1.0
GIT_COMMIT=local

# CORS allow-origin for the admin frontend.
FRONTEND_ORIGIN=http://localhost:3000

# Axum bind address.
BIND_ADDR=0.0.0.0:8000

# sqlx connection pool size.
DB_MAX_CONNECTIONS=10
